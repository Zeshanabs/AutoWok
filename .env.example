APP_ENV=development
APP_NAME=Autowok
APP_DEBUG=true
LOG_LEVEL=INFO

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=autowok_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
AI_ENCRYPTION_KEY=
AI_ENCRYPTION_KEY_PREVIOUS=
AI_CUSTOM_ENDPOINT_HOSTS=
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_ENABLED=true

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback
META_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
META_WEBHOOK_VERIFY_TOKEN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autowok
POSTGRES_USER=autowok
POSTGRES_PASSWORD=autowok
DATABASE_URL=postgresql+psycopg://autowok:autowok@localhost:5432/autowok
DOCKER_DATABASE_URL=postgresql+psycopg://autowok:autowok@postgres:5432/autowok

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

LOCAL_STORAGE_PATH=./storage/local
