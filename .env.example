APP_ENV=development
APP_NAME=Autowok
APP_DEBUG=true
LOG_LEVEL=INFO

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=autowok_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
AI_ENCRYPTION_KEY=
AI_ENCRYPTION_KEY_PREVIOUS=
AI_CUSTOM_ENDPOINT_HOSTS=
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_ENABLED=true
# Web search for the Research page. Provider: groq (reuse your Groq key), tavily or brave. Keys:
# https://tavily.com or https://brave.com/search/api. Leave the base URL empty.
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=
RESEARCH_SEARCH_BASE_URL=
RESEARCH_MAX_RESULTS=10
RESEARCH_TIMEOUT_SECONDS=30

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback
META_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
META_WEBHOOK_VERIFY_TOKEN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autowok
POSTGRES_USER=autowok
POSTGRES_PASSWORD=autowok
DATABASE_URL=postgresql+psycopg://autowok:autowok@localhost:5432/autowok
DOCKER_DATABASE_URL=postgresql+psycopg://autowok:autowok@postgres:5432/autowok

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

LOCAL_STORAGE_PATH=./storage/local

# Phase 7: media storage and signed media URLs
STORAGE_PROVIDER=local
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=104857600
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_URL_SIGNING_SECRET=
MEDIA_SIGNED_URL_TTL_SECONDS=3600
# Public HTTPS base URL of this backend that Meta can reach (e.g. an HTTPS tunnel
# in development). Required to publish posts that contain media.
PUBLIC_MEDIA_BASE_URL=

# Phase 7: publishing worker and retries
PUBLISHING_MAX_ATTEMPTS=3
PUBLISHING_BACKOFF_BASE_SECONDS=30
PUBLISHING_BACKOFF_MAX_SECONDS=900
PUBLISHING_LEASE_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=15

# Phase 8: scheduling and timezones
# Default IANA timezone for users who have not chosen one (do not assume a country).
DEFAULT_TIMEZONE=UTC
SCHEDULE_MIN_LEAD_SECONDS=60
SCHEDULE_MAX_HORIZON_DAYS=365
# Due posts older than this (e.g. after a long outage) are failed instead of published late.
SCHEDULE_MAX_LATENESS_SECONDS=21600

# Phase 9: analytics synchronization (Meta insights)
ANALYTICS_ENABLED=true
# How often each connected account is synchronized automatically (hours). Meta updates most Page Insights about once a day.
ANALYTICS_SYNC_INTERVAL_HOURS=12
ANALYTICS_INITIAL_LOOKBACK_DAYS=30
ANALYTICS_INCREMENTAL_LOOKBACK_DAYS=3
ANALYTICS_POST_LOOKBACK_DAYS=90
ANALYTICS_MAX_POSTS_PER_SYNC=100
ANALYTICS_SYNC_MAX_ATTEMPTS=3
ANALYTICS_SYNC_LEASE_SECONDS=900
ANALYTICS_MANUAL_REFRESH_COOLDOWN_MINUTES=15
ANALYTICS_MANUAL_REFRESH_LIMIT_PER_HOUR=6

# Phase 10: controlled workflow automations
AUTOMATION_ENABLED=true
# Hard limits applied to every workspace (see docs/phase-10-automations.md)
AUTOMATION_MAX_PER_WORKSPACE=50
AUTOMATION_MAX_ACTIONS=10
AUTOMATION_MAX_CONDITIONS=20
AUTOMATION_MAX_CONDITION_DEPTH=2
AUTOMATION_MAX_EXECUTIONS_PER_HOUR=60
AUTOMATION_WORKSPACE_MAX_EXECUTIONS_PER_DAY=1000
# Events caused by automation actions are dropped beyond this chain depth (loop protection).
AUTOMATION_MAX_CHAIN_DEPTH=3
AUTOMATION_MAX_RETRIES=3
AUTOMATION_EXECUTION_TIMEOUT_SECONDS=60
AUTOMATION_LEASE_SECONDS=300
AUTOMATION_MAX_CONCURRENT_EXECUTIONS=2
AUTOMATION_EVENT_MAX_ATTEMPTS=5
AUTOMATION_BACKOFF_BASE_SECONDS=15
AUTOMATION_BACKOFF_MAX_SECONDS=600

# Phase 11: multi-agent AI workflows (see docs/phase-11-multi-agent.md)
AGENTS_ENABLED=true
# Optional Groq model for agents only. Empty = the workspace model or GROQ_DEFAULT_MODEL.
# Use a model id from the live list (Settings > AI); none is built into the code.
AGENT_GROQ_MODEL=
# Hard limits for every workflow
AGENT_MAX_CALLS_PER_WORKFLOW=24
AGENT_MAX_WORKFLOW_SECONDS=900
AGENT_STEP_TIMEOUT_SECONDS=90
AGENT_MAX_STEP_ATTEMPTS=3
# Writer revisions requested automatically by reviewers, and revision rounds in total (including user requests)
AGENT_MAX_AUTO_REVISIONS=1
AGENT_MAX_REVISIONS=3
# 1 = one Groq request at a time, even for independent reviewers (recommended for free-tier rate limits)
AGENT_MAX_PARALLEL_CALLS=1
AGENT_LEASE_SECONDS=300
AGENT_MAX_ACTIVE_WORKFLOWS=3
AGENT_MAX_WORKFLOWS_PER_HOUR=20
AGENT_BACKOFF_BASE_SECONDS=20
AGENT_BACKOFF_MAX_SECONDS=300
# Below this editorial score (1-10) the writer is asked for a revision
AGENT_QUALITY_REVISION_THRESHOLD=6.0

# Phase 12: production operations (full reference: docs/configuration.md)
# Production deployments use .env.production.example with docker-compose.prod.yml.
SERVICE_NAME=autowok-api
# auto = JSON logs in production, readable text otherwise
LOG_FORMAT=auto
# API documentation (/docs). Unset = on in development, off in production.
API_DOCS_ENABLED=
# Comma-separated Host header allowlist; empty disables the check.
ALLOWED_HOSTS=
# Database connection pool (per process) and timeouts
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_SOCKET_TIMEOUT_SECONDS=5
# How often a session's "last used" time is written (0 = every request)
SESSION_TOUCH_INTERVAL_SECONDS=300
# JSON request body limit (media uploads use MEDIA_MAX_*_BYTES) and parallel upload processing
MAX_REQUEST_BODY_BYTES=1048576
UPLOAD_MAX_CONCURRENT=4
# Monitoring. METRICS_TOKEN protects /metrics and /api/v1/health/details and is
# required in production (openssl rand -hex 32). SENTRY_DSN is optional.
METRICS_ENABLED=true
METRICS_TOKEN=
SENTRY_DSN=
RELEASE_VERSION=
# Worker
WORKER_HEARTBEAT_FILE=
WORKER_HEARTBEAT_TTL_SECONDS=120
WORKER_TASK_BUDGET_SECONDS=120
WORKER_HOUSEKEEPING_INTERVAL_SECONDS=60
# Rate limits (per user per hour unless the name says otherwise)
RATE_LIMIT_LOGIN_PER_ACCOUNT_15M=20
RATE_LIMIT_AI_GENERATE_PER_HOUR=30
RATE_LIMIT_AI_TOOLS_PER_HOUR=120
RATE_LIMIT_RESEARCH_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=120
RATE_LIMIT_PUBLISH_PER_HOUR=60
RATE_LIMIT_SCHEDULE_PER_HOUR=240
RATE_LIMIT_EXPORT_PER_HOUR=30
RATE_LIMIT_MEMBER_ADD_PER_HOUR=20
RATE_LIMIT_PROVIDER_TEST_PER_HOUR=30
RATE_LIMIT_AUTOMATION_TEST_PER_HOUR=120
RATE_LIMIT_CLIENT_ERRORS_PER_HOUR=60
RATE_LIMIT_WORKSPACE_CREATE_PER_DAY=10
MAX_WORKSPACES_PER_USER=25

# --- Email (workspace invitations) ---------------------------------------------------
# Leave SMTP_HOST empty to switch email off: invitations are then created and the
# link is shown to the admin to pass on by hand. SMTP_SECURITY is starttls (port
# 587), ssl (port 465) or none. Gmail example: smtp.gmail.com, 587, your address
# as the username, and an "app password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
INVITATION_EXPIRY_DAYS=7
