APP_ENV=development
APP_NAME=Autowok
APP_DEBUG=true
LOG_LEVEL=INFO

FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=autowok_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
AI_ENCRYPTION_KEY=
AI_ENCRYPTION_KEY_PREVIOUS=
AI_CUSTOM_ENDPOINT_HOSTS=
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
GROQ_ENABLED=true
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=
RESEARCH_SEARCH_BASE_URL=
RESEARCH_MAX_RESULTS=10
RESEARCH_TIMEOUT_SECONDS=30

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta/callback
META_OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=
META_WEBHOOK_VERIFY_TOKEN=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autowok
POSTGRES_USER=autowok
POSTGRES_PASSWORD=autowok
DATABASE_URL=postgresql+psycopg://autowok:autowok@localhost:5432/autowok
DOCKER_DATABASE_URL=postgresql+psycopg://autowok:autowok@postgres:5432/autowok

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
DOCKER_REDIS_URL=redis://redis:6379/0

LOCAL_STORAGE_PATH=./storage/local

# Phase 7: media storage and signed media URLs
STORAGE_PROVIDER=local
MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=104857600
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_URL_SIGNING_SECRET=
MEDIA_SIGNED_URL_TTL_SECONDS=3600
# Public HTTPS base URL of this backend that Meta can reach (e.g. an HTTPS tunnel
# in development). Required to publish posts that contain media.
PUBLIC_MEDIA_BASE_URL=

# Phase 7: publishing worker and retries
PUBLISHING_MAX_ATTEMPTS=3
PUBLISHING_BACKOFF_BASE_SECONDS=30
PUBLISHING_BACKOFF_MAX_SECONDS=900
PUBLISHING_LEASE_SECONDS=600
WORKER_POLL_INTERVAL_SECONDS=15

# Phase 8: scheduling and timezones
# Default IANA timezone for users who have not chosen one (do not assume a country).
DEFAULT_TIMEZONE=UTC
SCHEDULE_MIN_LEAD_SECONDS=60
SCHEDULE_MAX_HORIZON_DAYS=365
# Due posts older than this (e.g. after a long outage) are failed instead of published late.
SCHEDULE_MAX_LATENESS_SECONDS=21600
