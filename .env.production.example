# Autowok production / staging configuration (used with docker-compose.prod.yml).
#
# Copy to .env.production, fill in every value marked REQUIRED, and keep the file
# out of version control (.gitignore already excludes it). Prefer your platform's
# secret store over a file where one exists. Full reference: docs/configuration.md.
#
# Generate secrets:
#   random string   openssl rand -hex 32
#   Fernet key      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# The API refuses to start in production when a REQUIRED security value is
# missing or unsafe, and names the variable in the error message.

APP_ENV=production                # "production" for staging too: staging must run the same checks
LOG_LEVEL=INFO

# --- Public address (REQUIRED) ----------------------------------------------------
SITE_ADDRESS=app.example.com      # host name the proxy serves and gets a certificate for
PUBLIC_ORIGIN=https://app.example.com
ALLOWED_HOSTS=app.example.com
ACME_EMAIL=ops@example.com        # certificate expiry notices

# --- Database and Redis (REQUIRED) ------------------------------------------------
POSTGRES_DB=autowok
POSTGRES_USER=autowok
POSTGRES_PASSWORD=                # openssl rand -hex 32 (hex: safe inside a connection URL)
REDIS_PASSWORD=                   # openssl rand -hex 32

# --- Encryption and signing (REQUIRED) --------------------------------------------
# Losing these keys makes stored provider keys and Meta tokens unreadable: back them
# up separately from the database backups (docs/backup-recovery.md).
AI_ENCRYPTION_KEY=                # Fernet key: encrypts workspace AI provider keys
AI_ENCRYPTION_KEY_PREVIOUS=       # only during rotation
TOKEN_ENCRYPTION_KEY=             # Fernet key (different from the one above): encrypts Meta tokens
TOKEN_ENCRYPTION_KEY_PREVIOUS=    # only during rotation
MEDIA_URL_SIGNING_SECRET=         # openssl rand -hex 32

# --- Monitoring (REQUIRED) ---------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=                    # openssl rand -hex 32; bearer token for /metrics and /api/v1/health/details
SENTRY_DSN=                       # optional; empty = errors go to the structured log only
RELEASE_VERSION=                  # optional; shown in error reports, e.g. the git commit

# --- Meta (required to connect and publish to Facebook/Instagram) -------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_REDIRECT_URI=https://app.example.com/api/v1/oauth/meta/callback
META_OAUTH_STATE_SECRET=          # openssl rand -hex 32

# --- Groq (optional platform key) ---------------------------------------------------
# Leave empty to require each workspace to configure its own key in Settings > AI.
# A platform key is shared by every workspace without its own key and is subject
# to Groq's rate limits and the RATE_LIMIT_AI_* settings below.
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=
GROQ_ENABLED=true
AGENT_GROQ_MODEL=

# --- Research search provider (optional) --------------------------------------------
RESEARCH_SEARCH_PROVIDER=
RESEARCH_SEARCH_API_KEY=
RESEARCH_SEARCH_BASE_URL=

# --- Backups -------------------------------------------------------------------------
BACKUP_PASSPHRASE=                # openssl rand -hex 32; store it where the backups are NOT stored
BACKUP_RETENTION_DAYS=14
BACKUP_HOST_DIR=./backups         # mount of an off-host or separately backed-up location

# --- Limits (optional; defaults shown) ------------------------------------------------
# RATE_LIMIT_AI_GENERATE_PER_HOUR=30
# RATE_LIMIT_AI_TOOLS_PER_HOUR=120
# RATE_LIMIT_RESEARCH_PER_HOUR=30
# RATE_LIMIT_UPLOAD_PER_HOUR=120
# RATE_LIMIT_PUBLISH_PER_HOUR=60
# RATE_LIMIT_SCHEDULE_PER_HOUR=240
# RATE_LIMIT_EXPORT_PER_HOUR=30
# RATE_LIMIT_WORKSPACE_CREATE_PER_DAY=10
# MAX_WORKSPACES_PER_USER=25
# MEDIA_MAX_IMAGE_BYTES=8388608
# MEDIA_MAX_VIDEO_BYTES=104857600
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
